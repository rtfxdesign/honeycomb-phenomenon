# Normalise line endings. The repo stores LF; working trees check out LF on
# every platform, so Windows editors stop rewriting whole files as CRLF and
# hiding real changes behind a wall of phantom diffs.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.mov binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary

# Text formats worth pinning explicitly.
*.svg text eol=lf
*.json text eol=lf
*.md text eol=lf

# Generated — collapsed by default in GitHub diffs, still readable when needed.
package-lock.json linguist-generated
